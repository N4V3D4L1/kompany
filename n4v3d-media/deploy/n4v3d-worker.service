# systemd unit — background production worker (survives logout/reboot; Claude Code need not be running)
# Install: sudo cp n4v3d-worker.service /etc/systemd/system/ && sudo systemctl enable --now n4v3d-worker
[Unit]
Description=N4V3D MEDIA production worker
After=network-online.target

[Service]
Type=simple
User=n4v3d
WorkingDirectory=/opt/n4v3d/kompany/n4v3d-media
Environment=PYTHONUNBUFFERED=1
# Optional: Environment=N4V3D_WEBHOOK_URL=https://...  (notifications)
ExecStart=/usr/bin/python3 -m n4v3d_media worker --interval 60
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
